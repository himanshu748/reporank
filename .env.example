# Copy this to .env and fill in values
# RepoRank uses zero env vars for Coral (it reads config/sources from CLI)
# Only Hugging Face API key is needed.

# Get yours at https://huggingface.co/settings/tokens
HF_TOKEN=hf_...

# Optional: GitHub token for higher Coral rate limits
# coral source add github  ← run this once, Coral stores it
GITHUB_TOKEN=ghp_...
